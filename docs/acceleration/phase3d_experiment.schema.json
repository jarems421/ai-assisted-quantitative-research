{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-os:proof-experiment:v001",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "mode", "hypothesis", "research_stage", "research_cutoff", "sealed_stage_rules", "contracts", "gates", "source_snapshots"],
  "properties": {
    "schema_version": {"const": "proof_experiment_v001"},
    "experiment_id": {"type": "string", "pattern": "^EXP[0-9]{3,}$"},
    "mode": {"enum": ["SYNTHETIC_INFRASTRUCTURE", "RESEARCH"]},
    "hypothesis": {"type": "string", "minLength": 1},
    "research_stage": {"enum": ["DRAFT", "DEVELOPMENT", "VALIDATION", "TEST_AUTHORIZED"]},
    "research_cutoff": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sealed_stage_rules": {"const": "existing_store_owner_test_and_paper_gates"},
    "contracts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/reference"}},
    "gates": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["status", "receipt_sha256"], "properties": {"status": {"enum": ["CERTIFIED", "PARTIAL", "BLOCKED"]}, "receipt_sha256": {"$ref": "#/$defs/hash"}}}},
    "source_snapshots": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "source_end"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "source_end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
