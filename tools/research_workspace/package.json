{
  "name": "research-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "export": "python export_workspace.py",
    "dev": "npm run export && vite --host 127.0.0.1",
    "build": "npm run export && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "python -m unittest discover -s tests -v && tsx --test tests/contracts.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": { "react": "19.2.0", "react-dom": "19.2.0" },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "vite": "7.2.2"
  }
}
