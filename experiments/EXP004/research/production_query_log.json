    {
      "request_name": "prices_2015_01",
      "request": {
        "query": "WITH bounds AS (SELECT CAST(? AS DATE) lo,CAST(? AS DATE) hi),\n    decisions(session,prior_session,decision_utc,expected_sessions) AS (VALUES (DATE '2015-01-02',DATE '2014-12-31',TIMESTAMP '2015-01-02T02:00:00',253)),\n    mapped AS (\n      SELECT o.ticker,CAST(o.date AS DATE) day,s.security_id,s.asset_type,o.unadjustedClose,\n        COUNT(*) OVER(PARTITION BY o.ticker,CAST(o.date AS DATE)) mappings\n      FROM lake.sec_daily_ohlc o JOIN lake.security_segments s ON o.ticker=s.ticker\n       AND CAST(o.date AS DATE) BETWEEN s.from_date AND COALESCE(s.to_date,DATE '2020-12-31'),bounds\n      WHERE CAST(o.date AS DATE) BETWEEN lo AND hi AND s.from_date<=hi),\n    valid AS (SELECT * FROM mapped WHERE mappings=1 AND asset_type='CS'\n      AND security_id IS NOT NULL AND unadjustedClose>0 AND isfinite(unadjustedClose)),\n    endpoints AS (\n      SELECT d.*,p.security_id,p.ticker,COUNT(*) OVER(PARTITION BY d.session,p.security_id) aliases\n      FROM decisions d JOIN valid p ON p.day=d.prior_session\n      JOIN lake.security_segments s ON s.ticker=p.ticker AND s.security_id=p.security_id\n       AND d.session BETWEEN s.from_date AND COALESCE(s.to_date,DATE '2020-12-31') AND s.asset_type='CS')\n    SELECT e.*,COUNT(DISTINCT p.day) days_365,COUNT(p.day) rows_365,\n      LIST(STRUCT_PACK(day:=p.day,ticker:=p.ticker,price:=p.unadjustedClose) ORDER BY p.day) bars\n    FROM endpoints e LEFT JOIN valid p ON p.security_id=e.security_id\n     AND p.day BETWEEN e.prior_session-INTERVAL 365 DAY AND e.prior_session\n    GROUP BY ALL ORDER BY e.session,e.security_id",
